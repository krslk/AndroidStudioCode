<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center|top"
    android:orientation="vertical"
    tools:context=".activity.OwnInfoActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal">

        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:onClick="toBack"
            android:scaleType="centerCrop"
            android:src="@mipmap/icon_back_left" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/noto_sans_sc_bold_9"
            android:gravity="center"
            android:text="个人中心"
            android:textSize="20dp" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/noto_sans_sc_bold_4"
        android:paddingStart="10dp"
        android:text="点击头像更改照片"
        android:textColor="@color/black" />

    <ImageView
        android:id="@+id/ownInfo_activity_avatar"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="5sp"
        android:scaleType="centerCrop"
        android:src="@mipmap/own_info_icon_update_avatar" />

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:fontFamily="@font/noto_sans_sc_bold_3"
            android:gravity="center|left"
            android:text="用户名"
            android:textColor="@color/black" />

        <EditText
            android:id="@+id/ownInfo_activity_username"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="输入用户名"
            android:maxLength="15"
            android:maxLines="1"
            android:paddingStart="5dp"
            android:textColor="@color/black"
            android:textColorHint="@color/color_et_hint" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:fontFamily="@font/noto_sans_sc_bold_3"
            android:gravity="center|left"
            android:text="电子邮箱"
            android:textColor="@color/black" />

        <EditText
            android:id="@+id/ownInfo_activity_email"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="输入邮箱"
            android:maxLength="20"
            android:maxLines="1"
            android:paddingStart="5dp"
            android:textColor="@color/black"
            android:textColorHint="@color/color_et_hint" />
    </LinearLayout>

    <Button
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/activity_login_btn"
        android:onClick="commitInfo"
        android:text="提交"
        android:textSize="15sp" />

</LinearLayout>