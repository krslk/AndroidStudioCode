<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="75dp"
    android:background="@drawable/background_listview_item"
    android:gravity="center"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/item_music_id"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="15dp"
        android:fontFamily="@font/noto_sans_sc_bold_3"
        android:gravity="center"
        android:text="99"
        android:textColor="@color/black"
        android:textSize="20dp"
        android:textStyle="bold" />

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_music_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:fontFamily="@font/noto_sans_sc_bold_3"
            android:textColor="@color/black"
            android:textSize="18sp"
            tools:text="吹喇叭" />

        <TextView
            android:id="@+id/item_music_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignLeft="@+id/item_music_name"
            android:layout_alignTop="@+id/item_music_name"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="10dp"
            android:textColor="@color/black"
            tools:text="欧江兰" />

    </RelativeLayout>

</LinearLayout>