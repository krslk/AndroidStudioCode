<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.RegisterActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:scaleType="centerCrop"
        android:src="@mipmap/img_login_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/shape_login_ll"
        android:gravity="center|top"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:text="TJNU"
            android:textColor="#4749BA"
            android:textSize="36sp" />

        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="42dp"
            android:layout_marginTop="43dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="账号"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_register_account"
                android:layout_width="216dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:background="@null"
                android:digits="@string/string_char_account_scope"
                android:gravity="center"
                android:hint="请输入账号"
                android:maxLength="15"
                android:textColor="@color/black"
                android:textColorHint="@color/color_et_hint" />

        </LinearLayout>

        <View
            android:layout_width="260dp"
            android:layout_height="3dp"
            android:background="@drawable/background_login_line" />

        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="42dp"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:inputType="text"
                android:text="密码"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_register_passwd"
                android:layout_width="216dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:background="@null"
                android:digits="@string/string_char_passwd_scope"
                android:gravity="center"
                android:hint="请输入密码"
                android:inputType="textPassword"
                android:maxLength="20"
                android:textColor="@color/black"
                android:textColorHint="@color/color_et_hint" />

        </LinearLayout>

        <View
            android:layout_width="260dp"
            android:layout_height="3dp"
            android:background="@drawable/background_login_line" />

        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="42dp"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:inputType="text"
                android:text="确认密码"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_register_rePasswd"
                android:layout_width="200dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:background="@null"
                android:digits="@string/string_char_passwd_scope"
                android:gravity="center"
                android:hint="请再次输入密码"
                android:inputType="textPassword"
                android:maxLength="20"
                android:textColor="@color/black"
                android:textColorHint="@color/color_et_hint" />

        </LinearLayout>

        <View
            android:layout_width="260dp"
            android:layout_height="3dp"
            android:background="@drawable/background_login_line" />

        <Button
            android:id="@+id/btn_login_login"
            android:layout_width="260dp"
            android:layout_height="45dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/activity_login_btn"
            android:onClick="register"
            android:text="注册"
            android:textSize="17sp" />

    </LinearLayout>


</RelativeLayout>