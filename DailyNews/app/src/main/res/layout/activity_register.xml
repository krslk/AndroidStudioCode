<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activity.LoginActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:scaleType="fitXY"
        android:src="@drawable/image_background_login_top" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="550dp"
        android:layout_alignParentBottom="true"
        android:layout_centerInParent="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="45dp"
            android:background="@drawable/shape_login_enter_info_card"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/icon_username" />

                <EditText
                    android:id="@+id/et_register_account"
                    android:layout_width="200dp"
                    android:layout_height="60dp"
                    android:digits="@string/string_account_allow_chars"
                    android:gravity="center"
                    android:hint="@string/string_enter_account"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/black"
                    android:textColorHint="#888484" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:src="@drawable/icon_mail" />

                <EditText
                    android:id="@+id/et_register_mail"
                    android:layout_width="200dp"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:hint="@string/string_enter_mail"
                    android:inputType="textEmailAddress"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/black"
                    android:textColorHint="#888484" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_register_mailCode"
                    android:layout_width="130dp"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:hint="@string/string_enter_mailCode"
                    android:inputType="number"
                    android:maxLength="6"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/black"
                    android:textColorHint="#888484" />

                <Button
                    android:layout_width="110dp"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_register_get_mail_code"
                    android:onClick="getMailCode"
                    android:text="发送验证码"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/shape_login_enter_info_card"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/icon_password" />

                <EditText
                    android:id="@+id/et_register_password"
                    android:layout_width="200dp"
                    android:layout_height="60dp"
                    android:digits="@string/string_password_allow_chars"
                    android:gravity="center"
                    android:hint="@string/string_enter_password"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/black"
                    android:textColorHint="#888484" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/shape_login_enter_info_card"
                android:gravity="center"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/icon_password" />

                <EditText
                    android:id="@+id/et_register_repassword"
                    android:layout_width="200dp"
                    android:layout_height="60dp"
                    android:digits="@string/string_password_allow_chars"
                    android:gravity="center"
                    android:hint="@string/string_enter_repassword"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/black"
                    android:textColorHint="#888484" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btn_login_toRegister"
            android:layout_width="270dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:background="@drawable/btn_shape_login_register"
            android:text="@string/string_register"
            android:textSize="22sp" />
    </LinearLayout>


</RelativeLayout>